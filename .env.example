# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon connection string. Use the pooled host (contains "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Password for the association console at /admin.
ADMIN_PASSWORD=""

# Signing key for the admin session cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
