# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon connection string. Use the pooled host (contains "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Password for the association console at /admin.
ADMIN_PASSWORD=""

# Signing key for the admin session cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Semaphore SMS (semaphore.co). Leave blank to switch texting off entirely —
# the app still works, it just says nothing by text.
SEMAPHORE_API_KEY=""
# Your registered sender name. Semaphore rejects a send without one, so this
# has to be a name they have approved — there is no usable default.
SEMAPHORE_SENDER_NAME=""

# Web push. Leave blank to switch browser notifications off; texting is
# unaffected. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Where a push service should complain if something is wrong with our sends.
VAPID_SUBJECT="mailto:you@example.com"
